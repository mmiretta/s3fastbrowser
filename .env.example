# S3FastBrowser configuration. Copy to .env and adjust.
# Every value here is a placeholder: replace it before use.

# --- Network (used by docker-compose.yml) -------------------------------
# Interface and port published on the host. Keep 127.0.0.1 unless the app is
# behind a reverse proxy with TLS (see docs/DEPLOY.md).
S3FB_BIND=127.0.0.1
S3FB_PORT=5001

# --- Flask ---------------------------------------------------------------
# Long random string, e.g. the output of: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Send the session cookie only over HTTPS (set to true behind TLS).
SESSION_COOKIE_SECURE=false
# Login session lifetime in seconds (default 8 hours).
PERMANENT_SESSION_LIFETIME=28800
# Trust X-Forwarded-* headers from a reverse proxy in front of the app.
S3FB_TRUST_PROXY=false

# --- Built-in authentication --------------------------------------------
# Enabled when a password or a password hash is set. Prefer the hash:
#   docker compose run --rm s3fastbrowser python src/auth.py hash-password
# Hashes contain '$': keep them in single quotes.
S3FB_AUTH_USERNAME=admin
S3FB_AUTH_PASSWORD=
S3FB_AUTH_PASSWORD_HASH=''
# Only if another layer (SSO proxy, VPN) authenticates every request:
S3FB_AUTH_DISABLED=false

# --- S3 endpoints ---------------------------------------------------------
# Allowlist of endpoints users may connect to (comma-separated URLs or
# patterns). Strongly recommended when the app is reachable by others: without
# it the server will connect to any URL typed into the form.
# Example: https://s3.amazonaws.com,https://s3.*.amazonaws.com,https://s3.example.internal:8443
S3FB_ALLOWED_ENDPOINTS=
# Pre-filled values in the connection form.
S3FB_DEFAULT_ENDPOINT=https://s3.amazonaws.com
S3FB_DEFAULT_REGION=us-east-1
# Verify TLS certificates of the S3 endpoint. For a private CA, mount the
# bundle and point S3FB_CA_BUNDLE to it instead of disabling verification.
S3FB_VERIFY_TLS=true
S3FB_CA_BUNDLE=

# --- Behaviour --------------------------------------------------------------
# presigned: the browser downloads directly from the S3 endpoint (fast).
# proxy: downloads are streamed through the app (endpoint not reachable from browsers).
S3FB_DOWNLOAD_MODE=presigned
# Largest object (MB) that previews which need the whole file may read.
S3FB_PREVIEW_MAX_MB=25
# Extra directories with preview plugins (separated by ':').
S3FB_PLUGIN_DIRS=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Gunicorn --------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=300
